# Copy this file to .env.test and fill in real values.
# .env.test is gitignored — never commit it.

# ---------------------------------------------------------------------------
# WIP build (Asgardeo IdP, email + OTP sign-in) — pnpm test:e2e
# ---------------------------------------------------------------------------

# Asgardeo test account (used for "Sign in with Email" flow)
# OTP is read automatically via Gmail API below; E2E_PASSWORD is only needed
# if the account falls back to password auth instead of OTP.
E2E_USERNAME=integration-e2e-test-bot@wso2.com

# Gmail API credentials for reading OTP emails automatically.
# Run `pnpm test:e2e:get-gmail-token` once locally to generate the refresh token.
# See tests/e2e/README.md for full setup instructions.
GMAIL_CLIENT_ID=<from Google Cloud Console OAuth client>
GMAIL_CLIENT_SECRET=<from Google Cloud Console OAuth client>
GMAIL_REFRESH_TOKEN=<generated by pnpm test:e2e:get-gmail-token>

# Optional: override the target URL (defaults to https://preview-o2-dev.devant.dev)
# E2E_BASE_URL=https://preview-o2-dev.devant.dev

# ---------------------------------------------------------------------------
# Cloud build (Thunder IdP, GitHub SSO) — pnpm test:e2e:cloud
# ---------------------------------------------------------------------------

# GitHub account for the bot. Thunder's hosted sign-in page offers only Google and
# GitHub — there is no email/OTP path on the cloud deployment.
E2E_GITHUB_USERNAME=<bot GitHub username>
E2E_GITHUB_PASSWORD=<bot GitHub password>

# Only needed if the bot account has TOTP two-factor enabled: the base32 setup key
# shown once during enrollment. Leave unset when the account has no 2FA — GitHub then
# emails a device-verification code, which is read from the same Gmail inbox above.
E2E_GITHUB_TOTP_SECRET=<base32 setup key>

# Only used on a first-ever sign-in, when Thunder shows its "create your organization"
# form because the GitHub identity has no org yet. Defaults derive a unique handle per run.
# E2E_ORG_NAME=E2E Test Org
# E2E_ORG_HANDLE=e2e-test-org

# Optional: override the cloud target URL
# E2E_CLOUD_BASE_URL=https://ipaas-console-development.gateway.dev.cloud.wso2.com

# ---------------------------------------------------------------------------
# Token mode — skip the GitHub sign-in and seed the session from a token
# ---------------------------------------------------------------------------

# Set to anything to use a platform-issued token instead of driving the browser
# login. The E2E_GITHUB_* credentials above are then unused. Deliberately its own
# switch rather than being implied by the two variables below: a typo in either
# would otherwise fall back to the browser login and pass, hiding that token mode
# never ran.
# E2E_TOKEN_MODE=1

# The token provider's endpoint. source=integration-platform issues the token to
# IPAAS_CONSOLE; any other client's billing plan carries no integration quota, so creating
# an integration returns 402.
# E2E_TOKEN_URL=https://api-platform-internal-gateway-gateway-runtime.openchoreo-data-plane:8443/development-wso2cloud-monitoring-token-provider-monitoring-token-provider/token?source=integration-platform

# Shared secret the token provider requires as X-Auth-Token. Only for E2E_TOKEN_URL.
# E2E_TOKEN_AUTH=<shared secret from the platform team>

# Skips certificate verification for the token fetch. The internal gateway serves an
# in-cluster service name that no certificate matches, so the in-cluster run sets this
# too — the token it returns is still validated on every use.
# E2E_TOKEN_TLS_INSECURE=1
